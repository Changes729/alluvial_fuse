{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) 启动",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/alluvial_fuse",
      "args": [
        "--mount=${workspaceFolder}/build/test",
        "--workdir=${workspaceFolder}/build/overlay/worker",
        "--upperdir=${workspaceFolder}/build/overlay/upper"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "[build] default"
    }
  ]
}
